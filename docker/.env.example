# Copie para .env (mesma pasta) e preencha. O .env tem segredos: não compartilhe nem publique.

# Banco do container (senhas longas e aleatórias)
DB_NAME=ecocity
DB_USER=ecocity
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Endereço público do site (links dos e-mails), sem barra no final. Ex.: https://seudominio.com.br
URL_BASE=http://localhost:8080

# 1 mostra detalhes de erro na tela (nunca com o site na internet)
DEBUG=0

# Token do Cloudflare Tunnel (painel Zero Trust > Networks > Tunnels > seu túnel > Docker, o texto depois de --token)
CLOUDFLARE_TUNNEL_TOKEN=

# IA local (Ollama no container "ollama"): 1 liga, 0 desliga (sem IA, as fotos seguem para o administrador / 24 h)
IA_ATIVA=1
IA_MODELO=qwen3-vl:8b-instruct

# E-mail da recuperação de senha (ex.: Gmail = smtp.gmail.com, 587, tls, senha de app)
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURANCA=tls
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_NOME=EcoCity
